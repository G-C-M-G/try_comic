+def expand_translation_regions(text_regions: List[TextBlock]) -> List[TextBlock]:
+    """Split conservatively aligned translations into their original OCR polygons."""
+    expanded = []
+    for region in text_regions:
+        translations = list(getattr(region, 'translation_segments', None) or [])
+        source_texts = list(getattr(region, 'texts', None) or [])
+        lines = np.asarray(region.lines).reshape(-1, 4, 2)
+        if len(lines) < 2 or len(translations) != len(lines) or len(source_texts) != len(lines):
+            expanded.append(region)
+            continue
+
+        for index, (line, source, translation) in enumerate(zip(lines, source_texts, translations)):
+            segment = copy.copy(region)
+            segment.lines = np.asarray([line], dtype=np.int32)
+            segment.texts = [source]
+            segment.text = source
+            segment.translation = translation
+            segment.translation_segments = None
+            segment.segment_index = index
+            segment._segment_parent = region
+            for key in _GEOMETRY_CACHE_KEYS:
+                segment.__dict__.pop(key, None)
+            expanded.append(segment)
+    return expanded
 

+_GEOMETRY_CACHE_KEYS = (
+    'xyxy', 'xywh', 'center', 'unrotated_polygons', 'unrotated_min_rect',
+    'min_rect', 'polygon_aspect_ratio', 'unrotated_size', 'aspect_ratio',
+    'polygon_object', 'area', 'real_area',

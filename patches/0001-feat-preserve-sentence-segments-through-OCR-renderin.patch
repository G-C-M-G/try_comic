     expanded = []
     for region in text_regions:
         translations = list(getattr(region, 'translation_segments', None) or [])
+        render_segments = list(getattr(region, 'render_segments', None) or [])
+        if render_segments and len(translations) == len(render_segments):
+            for index, (source_segment, translation) in enumerate(zip(render_segments, translations)):
+                lines = source_segment.get('lines') or []
+                if not lines:
+                    continue
+                segment = copy.copy(region)
+                segment.lines = np.asarray(lines, dtype=np.int32).reshape(-1, 4, 2)
+                segment.texts = [str(source_segment.get('text') or '')]
+                segment.text = segment.texts[0]
+                segment.translation = translation
+                segment.translation_segments = None
+                segment.render_segments = None
+                segment.segment_index = index
+                segment._segment_parent = region
+                segment.font_size = int(source_segment.get('font_size', region.font_size))
+                segment.fg_colors = np.asarray(source_segment.get('fg', region.fg_colors))
+                segment.bg_colors = np.asarray(source_segment.get('bg', region.bg_colors))
+                segment._direction = source_segment.get('direction', region.direction)
+                segment._alignment = source_segment.get('alignment', region.alignment)
+                for key in _GEOMETRY_CACHE_KEYS:
+                    segment.__dict__.pop(key, None)
+                expanded.append(segment)
+            continue
         source_texts = list(getattr(region, 'texts', None) or [])
         lines = np.asarray(region.lines).reshape(-1, 4, 2)
         if len(lines) < 2 or len(translations) != len(lines) or len(source_texts) != len(lines):
@@ -231,6 +255,10 @@ async def dispatch(
         if parent is not None:
             current = int(getattr(parent, 'font_size', 0) or 0)
             parent.font_size = min(current, region.font_size) if current > 0 else region.font_size
+            segment_index = getattr(region, 'segment_index', None)
+            render_segments = getattr(parent, 'render_segments', None)
+            if render_segments and segment_index is not None and segment_index < len(render_segments):
+                render_segments[segment_index]['font_size'] = int(region.font_size)

     # TODO: Maybe remove intersections


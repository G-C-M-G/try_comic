 from typing import Callable, List, Set, Optional, Tuple, Union
 from collections import defaultdict, Counter
 import os
@@ -20,7 +21,39 @@ from .model_48px import OCR
 from ..config import OcrConfig
 from ..textline_merge import split_text_region
 from ..utils import TextBlock, Quadrilateral, quadrilateral_can_merge_region, chunks
-from ..utils.generic import AvgMeter
+from ..utils.generic import AvgMeter
+
+_DAKUTEN_EQUIVALENTS = {
+    "が": "か", "ぎ": "き", "ぐ": "く", "げ": "け", "ご": "こ",
+    "ざ": "さ", "じ": "し", "ず": "す", "ぜ": "せ", "ぞ": "そ",
+    "だ": "た", "ぢ": "ち", "づ": "つ", "で": "て", "ど": "と",
+    "ば": "は", "び": "ひ", "ぶ": "ふ", "べ": "へ", "ぼ": "ほ",
+    "ぱ": "は", "ぴ": "ひ", "ぷ": "ふ", "ぺ": "へ", "ぽ": "ほ",
+    "ガ": "カ", "ギ": "キ", "グ": "ク", "ゲ": "ケ", "ゴ": "コ",
+    "ザ": "サ", "ジ": "シ", "ズ": "ス", "ゼ": "セ", "ゾ": "ソ",
+    "ダ": "タ", "ヂ": "チ", "ヅ": "ツ", "デ": "テ", "ド": "ト",
+    "バ": "ハ", "ビ": "ヒ", "ブ": "フ", "ベ": "ヘ", "ボ": "ホ",
+    "パ": "ハ", "ピ": "ヒ", "プ": "フ", "ペ": "ヘ", "ポ": "ホ",
+}
+
+
+def _dakuten_base(text: str) -> str:
+    return "".join(_DAKUTEN_EQUIVALENTS.get(char, char) for char in unicodedata.normalize("NFC", text))
+
+
+def _dakuten_count(text: str) -> int:
+    return sum(char in _DAKUTEN_EQUIVALENTS for char in unicodedata.normalize("NFC", text))
+
+
+def prefer_axis_aligned_dakuten(primary: str, axis_aligned: str) -> str:
+    """Keep an axis-aligned reread only when it restores lost voicing marks."""
+    primary = str(primary or "").strip()
+    axis_aligned = str(axis_aligned or "").strip()
+    if not primary or not axis_aligned or len(primary) != len(axis_aligned):
+        return primary
+    if _dakuten_base(primary) != _dakuten_base(axis_aligned):
+        return primary
+    return axis_aligned if _dakuten_count(axis_aligned) > _dakuten_count(primary) else primary

 async def merge_bboxes(bboxes: List[Quadrilateral], width: int, height: int) -> Tuple[List[Quadrilateral], int]:
     # step 1: divide into multiple text region candidates
@@ -158,8 +191,25 @@ class ModelMangaOCR(OfflineOCR):
                 merged_text_height = q.aabb.h
                 merged_d = 'h'
             merged_region_imgs.append(q.get_transformed_region(image, merged_d, merged_text_height))
-        for idx in range(len(merged_region_imgs)):
-            texts[idx] = self.mocr(Image.fromarray(merged_region_imgs[idx]))
+        for idx in range(len(merged_region_imgs)):
+            texts[idx] = self.mocr(Image.fromarray(merged_region_imgs[idx]))
+            # Perspective warping can weaken tiny dakuten/handakuten marks.  For
+            # nearly axis-aligned boxes, reread the original pixel crop and only
+            # accept differences that strictly restore voicing marks.
+            q = merged_quadrilaterals[idx][0]
+            if isinstance(q, Quadrilateral) and q.is_axis_aligned:
+                x1, y1, x2, y2 = (int(round(value)) for value in q.xyxy)
+                pad = max(2, int(round(q.font_size * 0.05)))
+                crop = image[
+                    max(0, y1 - pad):min(image.shape[0], y2 + pad),
+                    max(0, x1 - pad):min(image.shape[1], x2 + pad),
+                ]
+                if crop.size:
+                    reread = self.mocr(Image.fromarray(crop))
+                    corrected = prefer_axis_aligned_dakuten(texts[idx], reread)
+                    if corrected != texts[idx]:
+                        self.logger.info(f'dakuten reread: {texts[idx]} -> {corrected}')
+                    texts[idx] = corrected

         ix = 0
         out_regions = {}
